# انسخ الملف ده لـ .env.local على جهازك، أو حط القيم في Vercel > Settings > Environment Variables.
# ماتحطش أي قيمة حقيقية في الملف ده، لإنه بيترفع على GitHub.

NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Paymob (المرحلة التالتة). أول ما تتحط، الدفع بيتفعل لوحده.
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_SECRET=
NEXT_PUBLIC_PAYMOB_PUBLIC_KEY=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=
PAYMOB_APPLE_PAY_INTEGRATION_ID=
# لينك سكريبت Paymob Pixel من الـ Dashboard أو الدوكيومنتيشن بتاعهم
NEXT_PUBLIC_PAYMOB_PIXEL_SRC=
# PAYMOB_BASE_URL=https://accept.paymob.com

# مصادر البيانات: أول ما المفتاح يتحط، البحث المباشر بيشتغل لوحده
SEARCHAPI_KEY=
SCRAPECREATORS_KEY=
APIFY_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Supabase
# اللينك والمفتاح العام عليهم قيم افتراضية في src/lib/supabase/config.ts، فمش لازم تحطهم.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# المفتاح السري (من Supabase > Project Settings > API Keys > service_role أو secret). لازم لتفعيل الاشتراكات من Paymob.
SUPABASE_SERVICE_ROLE_KEY=

# بيانات الموقع والشركة (مطلوبة لصفحات الشروط وموافقة Paymob)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_CR=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
# بوت تليجرام للتنبيهات: اسم البوت من غير @، والتوكن من BotFather، وكلمة سر للـ webhook
NEXT_PUBLIC_TELEGRAM_BOT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# بيكسل ميتا وConversions API
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
# META_TEST_EVENT_CODE=

# البريد الإلكتروني عبر Resend
RESEND_API_KEY=
EMAIL_FROM=WinnerAds <hello@your-domain.com>

# حماية التذكيرات اليومية (Vercel Cron بيبعتها تلقائي)
CRON_SECRET=
